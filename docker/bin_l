#!/usr/local/bin/nu
# Standalone CLI binary for l command
def main [
  pattern?: glob
  --all(-a)
  --du(-d)
  --sort_by_size(-s)
] {
  let target = ($pattern | default "")
  let res = if ($target | is-empty) {
    if $all and $du {
      ls -a --du
    } else if $all {
      ls -a
    } else if $du {
      ls --du
    } else {
      ls
    }
  } else {
    if $all and $du {
      ls -a --du $pattern
    } else if $all {
      ls -a $pattern
    } else if $du {
      ls --du $pattern
    } else {
      ls $pattern
    }
  }

  if ($res | is-empty) {
    return $res
  }

  if ($du and $sort_by_size) {
    $res | sort-by -i type name | sort-by size
  } else if $sort_by_size {
    $res | sort-by size
  } else {
    $res | sort-by -i type name
  }
}
