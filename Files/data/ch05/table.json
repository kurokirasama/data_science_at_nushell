34;:&#34;km2 mi2&#34;,&#34;href&#34;:&#34;./Template:Km2_mi2&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;9596960&#34;}},&#34;i&#34;:0}}]}\">\n    9,596,960 (3,705,410)\n   </span>\n  </td>\n  <td id=\"mwtQ\">\n   <span about=\"#mwt83\" typeof=\"mw:Transclusion\" id=\"mwtg\" data-mw=\"{&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;km2 mi2&#34;,&#34;href&#34;:&#34;./Template:Km2_mi2&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;9326410&#34;}},&#34;i&#34;:0}}]}\">\n    9,326,410 (3,600,950)\n   </span>\n  </td>\n  <td id=\"mwtw\">\n   <span about=\"#mwt84\" typeof=\"mw:Transclusion\" id=\"mwuA\" data-mw=\"{&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;km2 mi2&#34;,&#34;href&#34;:&#34;./Template:Km2_mi2&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;270550&#34;}},&#34;i&#34;:0}}]}\">\n    270,550 (104,460)\n   </span>\n  </td>\n  <td id=\"mwuQ\">\n   2.8\n  </td>\n  <td id=\"mwug\">\n   <sup about=\"#mwt85\" class=\"mw-ref reference\" id=\"cite_ref-11\" rel=\"dc:references\" typeof=\"mw:Transclusion mw:Extension/ref\" data-mw=\"{&#34;name&#34;:&#34;ref&#34;,&#34;attrs&#34;:{&#34;group&#34;:&#34;lower-alpha&#34;},&#34;body&#34;:{&#34;id&#34;:&#34;mw-reference-text-cite_note-11&#34;},&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;efn&#34;,&#34;href&#34;:&#34;./Template:Efn&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;Largest country entirely in Asia, and second-largest country in the world by land area. Excludes [[Taiwan]], [[Sino-Indian border dispute|disputed territories with India]], and [[South China Sea Islands|disputed islands in the South China Sea]]. Figures for total area and water area also exclude all coastal and territorial waters.&lt;ref name=\\&#34;ciastats\\&#34;/&gt;&#34;}},&#34;i&#34;:0}}]}\">\n    <a href=\"#cite_note-11\" data-mw-group=\"lower-alpha\" id=\"mwuw\">\n     <span class=\"mw-reflink-text\" id=\"mwvA\">\n      <span class=\"cite-bracket\" id=\"mwvQ\">\n       [\n      </span>\n      e\n      <span class=\"cite-bracket\" id=\"mwvg\">\n       ]\n      </span>\n     </span>\n    </a>\n   </sup>\n   <sup about=\"#mwt91\" class=\"mw-ref reference\" id=\"cite_ref-13\" rel=\"dc:references\" typeof=\"mw:Transclusion mw:Extension/ref\" data-mw=\"{&#34;name&#34;:&#34;ref&#34;,&#34;attrs&#34;:{&#34;group&#34;:&#34;lower-alpha&#34;},&#34;body&#34;:{&#34;id&#34;:&#34;mw-reference-text-cite_note-13&#34;},&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;efn&#34;,&#34;href&#34;:&#34;./Template:Efn&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;The [[United Nations Statistics Division]], the &#39;&#39;[[The World Factbook|CIA World Factbook]]&#39;&#39;, and the &#39;&#39;[[Encyclopædia Britannica]]&#39;&#39; all rank the United States ahead of China in total area. However, the figures used by each source &#39;&#39;include&#39;&#39; coastal and territorial waters for the United States but &#39;&#39;exclude&#39;&#39; coastal and territorial waters for China. China&#39;s coastal and territorial water figures are unknown (no official publication) and thus cannot be added into China&#39;s total area figure. But &#39;&#39;Encyclopædia Britannica&#39;&#39; specifies the United States&#39; area excluding coastal and territorial waters as 9,525,067 {{km2}},&lt;ref name=\\&#34;US britan\\&#34;&gt;{{cite encyclopedia |url=https://www.britannica.com/facts/United-States |title=United States |encyclopedia=Encyclopædia Britannica |access-date=4 December 2017 |archive-date=27 September 2021 |archive-url=https://web.archive.org/web/20210927011311/https://www.britannica.com/facts/United-States |url-status=live }}&lt;/ref&gt; less than the figure given for China&#39;s area by any of the three sources. Therefore, while it can be determined that China has a larger area excluding coastal and territorial waters, it is unclear which country has a larger area including coastal and territorial waters.&#34;}},&#34;i&#34;:0}}]}\">\n    <a href=\"#cite_note-13\" data-mw-group=\"lower-alpha\" id=\"mwvw\">\n     <span class=\"mw-reflink-text\" id=\"mwwA\">\n      <span class=\"cite-bracket\" id=\"mwwQ\">\n       [\n      </span>\n      f\n      <span class=\"cite-bracket\" id=\"mwwg\">\n       ]\n      </span>\n     </span>\n    </a>\n   </sup>\n  </td>\n </tr>\n <tr id=\"mwww\">\n  <td id=\"mwxA\">\n   <span class=\"nowrap\" about=\"#mwt101\" typeof=\"mw:Transclusion\" id=\"mwxQ\" data-mw=\"{&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;nowrap&#34;,&#34;href&#34;:&#34;./Template:Nowrap&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34; {{nts|4}}&#34;}},&#34;i&#34;:0}}]}\">\n    <span data-sort-value=\"7000400000000000000♠\">\n     4\n    </span>\n   </span>\n  </td>\n  <td style=\"text-align:left\" typeof=\"mw:Transclusion\" about=\"#mwt102\" id=\"mwxg\" data-mw=\"{&#34;parts&#34;:[&#34;| &#34;,{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;left&#34;,&#34;href&#34;:&#34;./Template:Left&#34;},&#34;params&#34;:{},&#34;i&#34;:0}},&#34; {{flag|United States}} &#34;]}\">\n   <span class=\"flagicon nowrap\" about=\"#mwt103\" typeof=\"mw:Transclusion\" data-mw=\"{&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;flag&#34;,&#34;href&#34;:&#34;./Template:Flag&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;United States&#34;}},&#34;i&#34;:0}}]}\">\n    <span class=\"mw-image-border\" typeof=\"mw:File\">\n     <span>\n      <img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_the_United_States.svg\" src=\"//upload.wikimedia.org/wikipedia/en/thumb/a/a4/Flag_of_the_United_States.svg/40px-Flag_of_the_United_States.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//upload.wikimedia.org/wikipedia/en/thumb/a/a4/Flag_of_the_United_States.svg/60px-Flag_of_the_United_States.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"1235\" data-file-height=\"650\" data-file-type=\"drawing\" height=\"12\" width=\"23\" class=\"mw-file-element\">\n     </span>\n    </span>\n   </span>\n   <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/United_States\" title=\"United States\" about=\"#mwt103\">\n    United States\n   </a>\n  </td>\n  <td style=\"text-align:right\" typeof=\"mw:Transclusion\" about=\"#mwt104\" id=\"mwxw\" data-mw=\"{&#34;parts&#34;:[&#34;|| &#34;,{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;right&#34;,&#34;href&#34;:&#34;./Template:Right&#34;},&#34;params&#34;:{},&#34;i&#34;:0}},&#34; {{km2 mi2|9525067}} &#34;]}\">\n   <span about=\"#mwt105\" typeof=\"mw:Transclusion\" data-mw=\"{&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;km2 mi2&#34;,&#34;href&#34;:&#34;./Template:Km2_mi2&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;9525067&#34;}},&#34;i&#34;:0}}]}\">\n    9,525,067 (3,677,647)\n   </span>\n  </td>\n  <td id=\"mwyA\">\n   <span about=\"#mwt106\" typeof=\"mw:Transclusion\" id=\"mwyQ\" data-mw=\"{&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;km2 mi2&#34;,&#34;href&#34;:&#34;./Template:Km2_mi2&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;9147593&#34;}},&#34;i&#34;:0}}]}\">\n    9,147,593 (3,531,904)\n   </span>\n  </td>\n  <td id=\"mwyg\">\n   <span about=\"#mwt107\" typeof=\"mw:Transclusion\" id=\"mwyw\" data-mw=\"{&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;km2 mi2&#34;,&#34;href&#34;:&#34;./Template:Km2_mi2&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;377424&#34;}},&#34;i&#34;:0}}]}\">\n    377,424 (145,724)\n   </span>\n  </td>\n  <td id=\"mwzA\">\n   4.0\n  </td>\n  <td id=\"mwzQ\">\n   <sup about=\"#mwt108\" class=\"mw-ref reference\" id=\"cite_ref-17\" rel=\"dc:references\" typeof=\"mw:Transclusion mw:Extension/ref\" data-mw=\"{&#34;name&#34;:&#34;ref&#34;,&#34;attrs&#34;:{&#34;group&#34;:&#34;lower-alpha&#34;},&#34;body&#34;:{&#34;id&#34;:&#34;mw-reference-text-cite_note-17&#34;},&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;efn&#34;,&#34;href&#34;:&#34;./Template:Efn&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;Figures are from the U.S. Census and include \\&#34;inland\\&#34; water and \\&#34;Great Lakes\\&#34; water, but exclude coastal and territorial water.&lt;ref&gt;{{cite web |url = https://www.census.gov/geographies/reference-files/2010/geo/state-area.html |title = State Area Measurements and Internal Point Coordinates |date = 2010 |website = census.gov |access-date = 20 February 2024}}&lt;/ref&gt; The [[NOAA]] cites the Great Lakes as an example of internal water,&lt;ref&gt;\\&#34;Examples of internal waters include rivers, canals, and lakes, including The Great Lakes.\\&#34; {{cite web |url = https://www.noaa.gov/maritime-zones-and-boundaries#internal |title = Maritime Zones and Boundaries |date = 15 February 2024 |website = noaa.gov |access-date = 20 February 2024}}&lt;/ref&gt; but the federal government sometimes treats the Great Lakes as \\&#34;high seas\\&#34;.&lt;ref&gt;\\&#34;a number of U.S. federal court decisions have treated the Great Lakes as \\&#34;high seas\\&#34; for purposes of federal admiralty and maritime jurisdiction as well as for federal criminal jurisdiction.\\&#34; {{cite web |url = https://www.noaa.gov/general-counsel/gc-international-section/great-lakes |title = The Great Lakes |date = 20 March 2023 |website = noaa.gov |access-date = 20 February 2024}}&lt;/ref&gt;&#34;}},&#34;i&#34;:0}}]}\">\n    <a href=\"#cite_note-17\" data-mw-group=\"lower-alpha\" id=\"mwzg\">\n     <span class=\"mw-reflink-text\" id=\"mwzw\">\n      <span class=\"cite-bracket\" id=\"mw0A\">\n       [\n      </span>\n      g\n      <span class=\"cite-bracket\" id=\"mw0Q\">\n       ]\n      </span>\n     </span>\n    </a>\n   </sup>\n  </td>\n </tr>\n <tr id=\"mw0g\">\n  <td id=\"mw0w\">\n   <span data-sort-value=\"7000500000000000000♠\" about=\"#mwt132\" typeof=\"mw:Transclusion\" id=\"mw1A\" data-mw=\"{&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;nts&#34;,&#34;href&#34;:&#34;./Template:Nts&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;5&#34;}},&#34;i&#34;:0}}]}\">\n    5\n   </span>\n  </td>\n  <td id=\"mw1Q\">\n   <span class=\"flagicon nowrap\" about=\"#mwt133\" typeof=\"mw:Transclusion\" id=\"mw1g\" data-mw=\"{&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;flag&#34;,&#34;href&#34;:&#34;./Template:Flag&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;Brazil&#34;}},&#34;i&#34;:0}}]}\">\n    <span class=\"mw-image-border\" typeof=\"mw:File\">\n     <span>\n      <img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Brazil.svg\" src=\"//upload.wikimedia.org/wikipedia/en/thumb/0/05/Flag_of_Brazil.svg/40px-Flag_of_Brazil.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//upload.wikimedia.org/wikipedia/en/thumb/0/05/Flag_of_Brazil.svg/60px-Flag_of_Brazil.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"1000\" data-file-height=\"700\" data-file-type=\"drawing\" height=\"15\" width=\"22\" class=\"mw-file-element\">\n     </span>\n    </span>\n   </span>\n   <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Brazil\" title=\"Brazil\" about=\"#mwt133\" id=\"mw1w\">\n    Brazil\n   </a>\n  </td>\n  <td id=\"mw2A\">\n   <span about=\"#mwt134\" typeof=\"mw:Transclusion\" id=\"mw2Q\" data-mw=\"{&#34;parts&#34;:[{&#34;template&#34;:{&#34;target&#34;:{&#34;wt&#34;:&#34;km2 mi2&#34;,&#34;href&#34;:&#34;./Template:Km2_mi2&#34;},&#34;params&#34;:{&#34;1&#34;:{&#34;wt&#34;:&#34;8510346&#34;}},&#34;i&#34;:0}}]}\">\n    8,510,346 (3,285,862)\n   </span>\n  </td>\n  <td id=\"mw2g\">\n   <span about=\"#mwt135\" typeof=\"mw:Transclu